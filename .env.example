# Copia este archivo como .env y pon tus claves. Nunca subas .env al repositorio.
# Solo hace falta la clave del proveedor que vayas a usar.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Buscador de documentación técnica (plan gratuito: 1.000 búsquedas al mes): https://app.tavily.com
TAVILY_API_KEY=

# Modelo que usa la aplicación: gemini (3.6 Flash), gemini38, opus, sonnet o haiku. Por defecto, gemini.
AI_MODEL=gemini
